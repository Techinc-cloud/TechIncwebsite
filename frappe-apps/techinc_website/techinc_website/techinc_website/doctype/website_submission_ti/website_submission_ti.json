{
  "doctype": "DocType",
  "name": "Website Submission TI",
  "module": "Techinc Website",
  "engine": "InnoDB",
  "field_order": [
    "sec_contact",
    "kind",
    "status",
    "full_name",
    "email",
    "phone",
    "col_contact",
    "organization",
    "industry",
    "employees",
    "interest",
    "sec_message",
    "message",
    "sec_ticket",
    "subject",
    "priority",
    "col_ticket",
    "category",
    "helpdesk_ticket",
    "sec_ticket_desc",
    "description",
    "sec_assessment",
    "score",
    "band",
    "col_assessment",
    "assessment_version",
    "sec_answers",
    "answers",
    "sec_follow_up",
    "follow_up_notes",
    "col_crm",
    "lead_doctype",
    "lead",
    "sec_technical",
    "page",
    "referrer",
    "col_tech",
    "visitor_session",
    "submission_id",
    "payload_hash"
  ],
  "fields": [
    {
      "fieldname": "sec_contact",
      "label": "Submission & Contact Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "kind",
      "label": "Type",
      "fieldtype": "Select",
      "options": "contact\nconsultation\nassessment\nticket",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Follow-up status",
      "fieldtype": "Select",
      "options": "New\nIn Progress\nClosed",
      "default": "New",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "full_name",
      "label": "Name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data",
      "options": "Email",
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "phone",
      "label": "Phone",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "col_contact",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "organization",
      "label": "Organisation",
      "fieldtype": "Data",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "industry",
      "label": "Industry",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "employees",
      "label": "Company size",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "interest",
      "label": "Service interest",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "sec_message",
      "label": "Enquiry Notes & Message",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.message"
    },
    {
      "fieldname": "message",
      "label": "Tell us what is going on (Enquiry Notes)",
      "fieldtype": "Long Text",
      "read_only": 1
    },
    {
      "fieldname": "sec_ticket",
      "label": "Support Ticket Details",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.kind=='ticket' || doc.subject || doc.helpdesk_ticket"
    },
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Data",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nUrgent",
      "read_only": 1
    },
    {
      "fieldname": "col_ticket",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "helpdesk_ticket",
      "label": "Helpdesk Ticket",
      "fieldtype": "Data",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "sec_ticket_desc",
      "label": "Ticket Description",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.description"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Long Text",
      "read_only": 1
    },
    {
      "fieldname": "sec_assessment",
      "label": "Assessment Results",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.kind=='assessment' || doc.score"
    },
    {
      "fieldname": "score",
      "label": "Readiness score",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "band",
      "label": "Readiness band",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_assessment",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "assessment_version",
      "label": "Assessment version",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "sec_answers",
      "label": "Assessment Answers",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.answers && doc.answers.length > 0"
    },
    {
      "fieldname": "answers",
      "label": "Assessment answers",
      "fieldtype": "Table",
      "options": "Website Answer TI",
      "read_only": 1
    },
    {
      "fieldname": "sec_follow_up",
      "label": "Sales Follow-up & CRM Notes",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "follow_up_notes",
      "label": "Follow-up notes",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "col_crm",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "lead_doctype",
      "label": "Lead type",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": 1
    },
    {
      "fieldname": "lead",
      "label": "Lead",
      "fieldtype": "Dynamic Link",
      "options": "lead_doctype",
      "read_only": 1
    },
    {
      "fieldname": "sec_technical",
      "label": "Technical Metadata",
      "fieldtype": "Section Break",
      "collapsible": 1
    },
    {
      "fieldname": "page",
      "label": "Page",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "referrer",
      "label": "Referrer",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "col_tech",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "visitor_session",
      "label": "Visitor session",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "submission_id",
      "label": "Submission ID",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "payload_hash",
      "label": "Payload hash",
      "fieldtype": "Data",
      "hidden": 1,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Website Manager TI",
      "read": 1,
      "write": 1,
      "report": 1,
      "export": 1
    }
  ],
  "issingle": 0,
  "istable": 0,
  "track_changes": 1,
  "title_field": "full_name",
  "search_fields": "full_name,email,organization",
  "sort_field": "creation",
  "sort_order": "DESC",
  "autoname": "prompt"
}
